 static void config_driver_mount_complete(uint8_t daddr, uint8_t idx, uint8_t const* desc_report, uint16_t desc_len) {
   hidh_interface_t* p_hid = get_hid_itf(daddr, idx);
   TU_VERIFY(p_hid,);
+#if CFG_TUH_HID_DEFER_INPUT_ENDPOINT
+  bool has_input = false;
+  uint16_t offset = 0;
+  while (desc_report && offset < desc_len) {
+    uint8_t const prefix = desc_report[offset++];
+    if (prefix == 0xfe) {
+      if ((desc_len - offset) < 2) break;
+      uint8_t const item_size = desc_report[offset];
+      offset += 2;
+      if (item_size > (desc_len - offset)) break;
+      offset += item_size;
+      continue;
+    }
+
+    uint8_t item_size = prefix & 0x03u;
+    if (item_size == 3) item_size = 4;
+    if (item_size > (desc_len - offset)) break;
+    if ((prefix & 0xfcu) == 0x80u) {
+      has_input = true;
+      break;
+    }
+    offset += item_size;
+  }
+
+  if (has_input && p_hid->epin_desc.bLength) {
+    if (!tuh_edpt_open(daddr, &p_hid->epin_desc)) {
+      uint8_t const itf_num = p_hid->itf_num;
+      tu_memclr(p_hid, sizeof(hidh_interface_t));
+      usbh_driver_set_config_complete(daddr, itf_num);
+      return;
+    }
+    p_hid->ep_in = p_hid->epin_desc.bEndpointAddress;
+    p_hid->epin_size = tu_edpt_packet_size(&p_hid->epin_desc);
+  }
+#endif
   p_hid->mounted = true;
 
   // enumeration is complete
