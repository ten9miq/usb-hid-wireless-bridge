@@ -570,5 +579,46 @@ void hcd_int_disable(uint8_t rhport)
 //--------------------------------------------------------------------+
 // Endpoint API
 //--------------------------------------------------------------------+
 
+#ifdef HID_HOST_DIAGNOSTICS
+bool hcd_rp2040_diagnostic_snapshot(hcd_rp2040_diagnostic_snapshot_t* snapshot)
+{
+  TU_VERIFY(snapshot);
+  memset(snapshot, 0, sizeof(*snapshot));
+
+  uint32_t const irq_state = save_and_disable_interrupts();
+  snapshot->interrupt_slot_count = PICO_USB_HOST_INTERRUPT_ENDPOINTS;
+  snapshot->int_ep_suppressed = int_ep_suppressed;
+  snapshot->epx_state = (epx.configured ? 0x01u : 0u) |
+                        (epx.active ? 0x02u : 0u) |
+                        (epx.pending ? 0x04u : 0u);
+  snapshot->control_timeout_count = diagnostic_control_timeout_count;
+  snapshot->saved_int_ep_ctrl = saved_int_ep_ctrl;
+  snapshot->current_int_ep_ctrl = usb_hw->int_ep_ctrl;
+  snapshot->interrupt_enable_mask =
+      (uint16_t) ((snapshot->current_int_ep_ctrl & USB_INT_EP_CTRL_BITS) >> 1);
+
+  for (uint i = 1; i < TU_ARRAY_SIZE(ep_pool); i++)
+  {
+    struct hw_endpoint const* ep = &ep_pool[i];
+    uint16_t const bit = (uint16_t) (1u << (i - 1));
+    if (ep->configured) snapshot->configured_mask |= bit;
+    if (ep->active) snapshot->active_mask |= bit;
+
+    if (ep->configured)
+    {
+      bool claimed = false;
+      bool busy = false;
+      if (usbh_diagnostic_edpt_state(ep->dev_addr, ep->ep_addr, &claimed, &busy))
+      {
+        if (claimed) snapshot->claimed_mask |= bit;
+        if (busy) snapshot->busy_mask |= bit;
+      }
+    }
+  }
+  restore_interrupts(irq_state);
+  return true;
+}
+#endif
+
 bool hcd_edpt_open(uint8_t rhport, uint8_t dev_addr, tusb_desc_endpoint_t const * ep_desc)
