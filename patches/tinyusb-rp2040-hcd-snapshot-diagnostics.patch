 #endif
diff --git a/src/host/usbh.c b/src/host/usbh.c
--- a/src/host/usbh.c
+++ b/src/host/usbh.c
@@ -974,4 +974,18 @@ bool usbh_edpt_busy(uint8_t dev_addr, uint8_t ep_addr) {
   return dev->ep_status[epnum][dir].busy;
 }
 
+#ifdef HID_HOST_DIAGNOSTICS
+bool usbh_diagnostic_edpt_state(uint8_t dev_addr, uint8_t ep_addr,
+                                bool* claimed, bool* busy) {
+  usbh_device_t* dev = get_device(dev_addr);
+  if (!dev) return false;
+
+  uint8_t const epnum = tu_edpt_number(ep_addr);
+  uint8_t const dir = tu_edpt_dir(ep_addr);
+  *claimed = dev->ep_status[epnum][dir].claimed;
+  *busy = dev->ep_status[epnum][dir].busy;
+  return true;
+}
+#endif
+
