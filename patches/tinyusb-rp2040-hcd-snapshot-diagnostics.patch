                                     uint16_t value);
+typedef struct {
+  uint8_t interrupt_slot_count;
+  uint8_t int_ep_suppressed;
+  uint8_t epx_state;
+  uint32_t control_timeout_count;
+  uint32_t saved_int_ep_ctrl;
+  uint32_t current_int_ep_ctrl;
+  uint16_t interrupt_enable_mask;
+  uint16_t configured_mask;
+  uint16_t claimed_mask;
+  uint16_t active_mask;
+  uint16_t busy_mask;
+} hcd_rp2040_diagnostic_snapshot_t;
+
+bool hcd_rp2040_diagnostic_snapshot(hcd_rp2040_diagnostic_snapshot_t* snapshot);
+bool usbh_diagnostic_edpt_state(uint8_t dev_addr, uint8_t ep_addr,
