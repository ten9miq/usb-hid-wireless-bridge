diff --git a/src/portable/raspberrypi/rp2040/hcd_rp2040.c b/src/portable/raspberrypi/rp2040/hcd_rp2040.c
--- a/src/portable/raspberrypi/rp2040/hcd_rp2040.c
+++ b/src/portable/raspberrypi/rp2040/hcd_rp2040.c
@@ -66,10 +66,91 @@ static struct hw_endpoint ep_pool[1 + PICO_USB_HOST_INTERRUPT_ENDPOINTS];
 // a simultaneous EPX transaction and stall enumeration of another device.
 static uint32_t saved_int_ep_ctrl;
 static bool int_ep_suppressed;
+// The hardware can poll only one asynchronous endpoint at a time.  Slot zero
+// means that none is selected; the cursor is the first slot considered at the
+// next SOF.
+static uint8_t int_ep_selected;
+static uint8_t int_ep_rr_cursor;
 #ifdef HID_HOST_DIAGNOSTICS
 static uint32_t diagnostic_control_timeout_count;
 #endif
 
+static bool int_ep_eligible(uint8_t slot)
+{
+  return slot > 0 && slot < TU_ARRAY_SIZE(ep_pool) &&
+         ep_pool[slot].configured && ep_pool[slot].active;
+}
+
+static void int_ep_program_selected(void)
+{
+  uint32_t mask = 0;
+
+  if (!int_ep_eligible(int_ep_selected))
+  {
+    int_ep_selected = 0;
+  }
+
+  if (int_ep_selected)
+  {
+    struct hw_endpoint const *ep = &ep_pool[int_ep_selected];
+    mask = 1u << (ep->interrupt_num + 1u);
+  }
+
+  // Do not use the atomic set/clear aliases here: this register must always
+  // contain either no slot or exactly one live asynchronous endpoint.
+  usb_hw->int_ep_ctrl = int_ep_suppressed ? 0 : mask;
+}
+
+static void int_ep_select_next(void)
+{
+  uint8_t slot = int_ep_rr_cursor;
+
+  int_ep_selected = 0;
+  for (uint i = 0; i < PICO_USB_HOST_INTERRUPT_ENDPOINTS; i++)
+  {
+    if (slot >= TU_ARRAY_SIZE(ep_pool)) slot = 1;
+    if (int_ep_eligible(slot))
+    {
+      int_ep_selected = slot;
+      slot++;
+      break;
+    }
+    slot++;
+  }
+
+  if (slot >= TU_ARRAY_SIZE(ep_pool)) slot = 1;
+  int_ep_rr_cursor = slot;
+  int_ep_program_selected();
+}
+
+static void int_ep_ensure_selected(void)
+{
+  if (int_ep_eligible(int_ep_selected))
+  {
+    int_ep_program_selected();
+  }
+  else
+  {
+    int_ep_select_next();
+  }
+}
+
+static void int_ep_deschedule(struct hw_endpoint *ep, bool sof_pending)
+{
+  uint8_t const slot = (uint8_t) (ep - ep_pool);
+  if (int_ep_selected != slot) return;
+
+  int_ep_selected = 0;
+  int_ep_program_selected();
+
+  // A simultaneous SOF owns the next rotation.  Otherwise keep the hardware
+  // busy by choosing the next live endpoint immediately.
+  if (!sof_pending)
+  {
+    int_ep_ensure_selected();
+  }
+}
+
 static void suppress_int_polling(void)
 {
   if (!int_ep_suppressed)
