@@ -292,6 +382,13 @@ static void __tusb_irq_path_func(hcd_rp2040_irq)(void)
   {
     handled |= USB_INTE_HOST_SOF_BITS;
     usb_hw->sof_rd; // HOST_SOF interrupt is cleared by reading SOF_RD
+    // Keep the current choice while EPX owns the shared handshake latches.
+    // Otherwise rotate even after a NAK, so a permanently NAKing endpoint
+    // cannot starve another active endpoint.
+    if (!int_ep_suppressed)
