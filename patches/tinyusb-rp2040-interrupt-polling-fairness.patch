     if (tuh_sof_cb) {
       hcd_event_t event;
       event.rhport              = RHPORT_NATIVE;
@@ -423,9 +516,6 @@ static void _hw_endpoint_init(struct hw_endpoint *ep, uint8_t dev_addr, uint8_t
     }
     usb_hw->int_ep_addr_ctrl[ep->interrupt_num] = reg;
 
