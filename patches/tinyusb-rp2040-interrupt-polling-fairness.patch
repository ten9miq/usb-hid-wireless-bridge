   }
@@ -455,6 +545,8 @@ bool hcd_init(uint8_t rhport)
   memset(&ep_pool, 0, sizeof(ep_pool));
   saved_int_ep_ctrl = 0;
   int_ep_suppressed = false;
+  int_ep_selected = 0;
+  int_ep_rr_cursor = 1;
 #ifdef HID_HOST_DIAGNOSTICS
   diagnostic_control_timeout_count = 0;
 #endif
@@ -531,14 +623,14 @@ void hcd_device_close(uint8_t rhport, uint8_t dev_addr)
 
   if (dev_addr == 0) return;
 
+  uint32_t const irq_state = save_and_disable_interrupts();
+
   for (size_t i = 1; i < TU_ARRAY_SIZE(ep_pool); i++)
   {
     hw_endpoint_t* ep = &ep_pool[i];
 
     if (ep->dev_addr == dev_addr && ep->configured)
