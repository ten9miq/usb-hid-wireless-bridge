@@ -548,6 +640,11 @@ void hcd_device_close(uint8_t rhport, uint8_t dev_addr)
       hw_endpoint_reset_transfer(ep);
     }
   }
+
+  // Removing the selected slot must never leave it armed.  Preserve a live
+  // selected slot, otherwise choose the next eligible one.
+  int_ep_ensure_selected();
+  restore_interrupts(irq_state);
 }
 
 uint32_t hcd_frame_number(uint8_t rhport)
@@ -703,7 +800,12 @@ bool hcd_edpt_xfer(uint8_t rhport, uint8_t dev_addr, uint8_t ep_addr, uint8_t *
